<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox 關閉。
	     本 App 是框架的配套開發者工具，需要兩件沙盒禁止的事：
	     (1) 執行專案內的 doc CLI（沙盒下 python3 被 xcrun shim 拒絕、
	         使用者安裝的 binary 直接 Operation not permitted）
	     (2) 讀取使用者指定的任意專案資料夾而不需每次重新授權
	     發布通路改為 Developer ID + notarization，不上架 Mac App Store。 -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened Runtime（notarization 必要條件）下，Dart VM 的 JIT 需要此項。
	     僅 debug；release 走 AOT 不需要。 -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- incoming 連線：Flutter 的 hot reload 與 VM service 需要，僅 debug。 -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
