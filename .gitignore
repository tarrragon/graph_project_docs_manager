# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# ── Flutter app 補充（原檔為 Dart package 模板，以下為手動補齊）──

# IntelliJ / Android Studio：專案設定屬個人環境，不入庫
.idea/
*.iml
*.ipr
*.iws

# VS Code：只保留團隊共用的設定，個人偏好與快取排除
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# macOS
.DS_Store

# 各平台編譯產物（子資料夾的 build 也一併排除）
**/build/
**/.dart_tool/

# CocoaPods lock（iOS / macOS）
ios/Podfile.lock
macos/Podfile.lock

# 其他
*.log

# FVM Version Cache
.fvm/

# 注意：lib/l10n/app_localizations*.dart 是 gen-l10n 的產物，但刻意「入庫」。
# Flutter 3.32 起不再走 synthetic package，產物落在 lib/ 下；納入版控可讓
# clone 後無需先執行生成即可開啟 IDE，語系變更也會出現在 diff 中可供審閱。
# 請勿為它們新增忽略規則。

# ── Claude 框架（.claude/）的本地執行期產物，不入庫 ──
# 清單來源：.claude/lib/sync_exclude_manifest.py 的 GITIGNORE_EXPECTED
# 框架本體要入庫，僅以下子路徑排除。
.claude/.sync-conflicts
.claude/.sync-state.json
.claude/.version-release.yaml
.claude/.zhtw-mcp-skip
.claude/ARCHITECTURE_REVIEW_REQUIRED
.claude/PM_INTERVENTION_REQUIRED
.claude/TASK_AVOIDANCE_FIX_MODE
.claude/analyses
.claude/dispatch-active.json
.claude/dispatch-active.lock
.claude/handoff
.claude/hook-logs
.claude/hook-state
.claude/logs
.claude/migration-backups
.claude/plans
.claude/pm-status.json
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/state
.claude/sync-preserve.yaml
.claude/sync-skills.yaml
.claude/worktrees

# Python 執行期產物（全域）
.pytest_cache
.venv
__pycache__

# project-init onboard 要求的框架規則
coverage/
htmlcov/
.claude/tool-results/
